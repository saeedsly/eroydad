Options -Indexes
RewriteEngine On

# This htdocs subfolder is a local-test wrapper: expose only public assets and the front controller.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:backend|database|deployment|storage|tests|frontend/views)(?:/|$) - [F,L,NC]
# Public static files are served from the only public tree.
RewriteRule ^assets/(.*)$ frontend/public/assets/$1 [END]
# Progressive web app files (installable offline page and service worker).
RewriteRule ^(manifest\.webmanifest|sw\.js)$ frontend/public/$1 [END]

# Application routes go through the public front controller.
RewriteRule ^$ frontend/public/index.php [END]
RewriteRule . frontend/public/index.php [END,QSA]
